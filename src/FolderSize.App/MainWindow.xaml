<Window x:Class="FolderSize.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:FolderSize.App.Localization" xmlns:infra="clr-namespace:FolderSize.App.Infrastructure" Title="FolderSize" Width="1200" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="Assets/FolderSize.ico">
  <Window.Resources><infra:WindowsIconConverter x:Key="WindowsIcon"/></Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="Assets/FolderSize.png" Width="44" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel><TextBlock Text="FolderSize" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{loc:Text Subtitle}" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{loc:Text Language}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/><ComboBox x:Name="LanguagePicker" Width="112" Padding="7,6" VerticalContentAlignment="Center" ItemsSource="{x:Static loc:LanguageService.AvailableLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding LanguageCode, Source={x:Static loc:LanguageService.Current}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text Language}"/></StackPanel><Button Content="{loc:Text About}" Click="About_Click"/><Button Content="{loc:Text Help}" Click="Help_Click"/></StackPanel></Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8,8,0,0" Padding="18">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanScan}" Padding="10" VerticalContentAlignment="Center" ToolTip="{Binding PathInput}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanCommand}"/></TextBox.InputBindings></TextBox>
        <Button Grid.Column="1" Content="{loc:Text PickFolder}" Click="Pick_Click" IsEnabled="{Binding CanScan}" Margin="10,0,4,0"/>
        <Button Grid.Column="2" Content="{loc:Text ScanButton}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Grid.Column="3" Content="{loc:Text Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
      </Grid>
      <Grid Margin="2,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{loc:Text LogicalSize}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalSize}" Style="{StaticResource Stat}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{loc:Text Files}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalFiles}" Style="{StaticResource Stat}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{loc:Text Folders}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalDirectories}" Style="{StaticResource Stat}"/></StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Foreground="#288157" TextWrapping="Wrap" VerticalAlignment="Center" Margin="18,0,0,0"/>
      </Grid></StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#D7DFEA" BorderThickness="1,0,1,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Grid><ListView x:Name="TreeList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewKeyDown="Tree_KeyDown">
        <ListView.View><GridView AllowsColumnReorder="False">
          <GridViewColumn Header="{loc:Text Name}" Width="310"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding Node.FullPath}"><Button Style="{StaticResource TreeExpander}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/><Image Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><MultiBinding Converter="{StaticResource WindowsIcon}"><Binding Path="Node.FullPath"/><Binding Path="Node.IsDirectory"/><Binding Path="Row.IsExpanded"/></MultiBinding></Image.Source></Image><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Note}" FontSize="11" Foreground="#A86E28" Margin="8,2,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="{loc:Text SizeDescending}" Width="120" DisplayMemberBinding="{Binding Size}"/>
          <GridViewColumn Header="{loc:Text ParentShare}" Width="140"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Width="110"><TextBlock Text="{Binding Share}" FontSize="12"/><ProgressBar Value="{Binding ShareValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,5,0,0" Foreground="#5283E7" Background="#E9EEF5" BorderThickness="0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="{loc:Text FileCount}" Width="90" DisplayMemberBinding="{Binding Count}"/>
        </GridView></ListView.View>
      </ListView><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="{loc:Text EmptyTitle}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="{loc:Text EmptyHint}" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/></StackPanel></Grid>
      <Border Grid.Column="1" Background="#FBFCFE" BorderBrush="#E0E6EE" BorderThickness="1,0,0,0" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="{loc:Text Selected}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedRow.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8"/>
        <TextBlock Text="{Binding SelectedRow.Node.FullPath}" Foreground="#64748B" TextWrapping="Wrap" ToolTip="{Binding SelectedRow.Node.FullPath}" MaxHeight="160" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding SelectedRow.Size}" FontSize="27" FontWeight="SemiBold" Margin="0,20,0,20"/>
        <Button Content="{loc:Text OpenExplorer}" Command="{Binding OpenCommand}" Margin="0,0,0,12"/>
        <Button Content="{loc:Text Recycle}" Command="{Binding RecycleCommand}" Foreground="#B93646" BorderBrush="#E5BEC5" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding RecycleReason}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
        <Separator Margin="0,22,0,16"/><TextBlock Text="{loc:Text ShareHint}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
      </StackPanel></ScrollViewer></Border>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Foreground="#64748B" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{Binding IssueLabel}" Click="Issues_Click" Padding="8,4" FontSize="12"/></Grid>
  </Grid>
</Window>
