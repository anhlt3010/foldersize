<Window x:Class="FolderSize.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderSize" Width="1200" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FolderSize" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Tìm nhanh file và thư mục chiếm nhiều dung lượng" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Trợ giúp" Click="Help_Click" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8,8,0,0" Padding="18">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanScan}" Padding="10" VerticalContentAlignment="Center" ToolTip="{Binding PathInput}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanCommand}"/></TextBox.InputBindings></TextBox>
        <Button Grid.Column="1" Content="Chọn thư mục…" Click="Pick_Click" IsEnabled="{Binding CanScan}" Margin="10,0,4,0"/>
        <Button Grid.Column="2" Content="Quét / Quét lại" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
        <Button Grid.Column="3" Content="Hủy" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
      </Grid>
      <Grid Margin="2,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="KÍCH THƯỚC LOGIC" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalSize}" Style="{StaticResource Stat}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="FILE" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalFiles}" Style="{StaticResource Stat}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="THƯ MỤC" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalDirectories}" Style="{StaticResource Stat}"/></StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Foreground="#288157" TextWrapping="Wrap" VerticalAlignment="Center" Margin="18,0,0,0"/>
      </Grid></StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#D7DFEA" BorderThickness="1,0,1,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Grid><ListView x:Name="TreeList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewKeyDown="Tree_KeyDown">
        <ListView.View><GridView AllowsColumnReorder="False">
          <GridViewColumn Header="Tên" Width="310"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding Node.FullPath}"><Button Content="{Binding Toggle}" Width="22" Padding="0" Margin="0,0,5,0" BorderThickness="0" Background="Transparent" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Focusable="False"/><TextBlock Text="{Binding Icon}" Foreground="#5685DA" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Note}" FontSize="11" Foreground="#A86E28" Margin="8,2,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="Dung lượng ↓" Width="120" DisplayMemberBinding="{Binding Size}"/>
          <GridViewColumn Header="% thư mục cha" Width="140"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Width="110"><TextBlock Text="{Binding Share}" FontSize="12"/><ProgressBar Value="{Binding ShareValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,5,0,0" Foreground="#5283E7" Background="#E9EEF5" BorderThickness="0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
          <GridViewColumn Header="Số file" Width="90" DisplayMemberBinding="{Binding Count}"/>
        </GridView></ListView.View>
      </ListView><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"><TextBlock Text="Chọn một vị trí để bắt đầu" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Nhập đường dẫn thư mục hoặc ổ đĩa, rồi bấm Quét." Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/></StackPanel></Grid>
      <Border Grid.Column="1" Background="#FBFCFE" BorderBrush="#E0E6EE" BorderThickness="1,0,0,0" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="ĐANG CHỌN" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedRow.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8"/>
        <TextBlock Text="{Binding SelectedRow.Node.FullPath}" Foreground="#64748B" TextWrapping="Wrap" ToolTip="{Binding SelectedRow.Node.FullPath}" MaxHeight="160" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding SelectedRow.Size}" FontSize="27" FontWeight="SemiBold" Margin="0,20,0,20"/>
        <Button Content="Mở trong Explorer ↗" Command="{Binding OpenCommand}" Margin="0,0,0,12"/>
        <Button Content="Chuyển vào Thùng rác" Command="{Binding RecycleCommand}" Foreground="#B93646" BorderBrush="#E5BEC5" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding RecycleReason}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
        <Separator Margin="0,22,0,16"/><TextBlock Text="Tỷ lệ chỉ tính trên dung lượng đọc được của thư mục cha. Liên kết được bỏ qua; kết quả có thể chưa đầy đủ." TextWrapping="Wrap" Foreground="#64748B" FontSize="12"/>
      </StackPanel></ScrollViewer></Border>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Foreground="#64748B" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{Binding IssueLabel}" Click="Issues_Click" Padding="8,4" FontSize="12"/></Grid>
  </Grid>
</Window>
